<Project Sdk="Microsoft.NET.Sdk">
  <!-- Motion AI: provider contract, Kimodo runner client (separate process), procedural provider, SOMA skeleton, retargeting. Godot-independent. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Blazma.AI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Blazma.Core/Blazma.Core.csproj" />
    <ProjectReference Include="../Blazma.Rigging/Blazma.Rigging.csproj" />
    <ProjectReference Include="../Blazma.Motion/Blazma.Motion.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Kimodo download packages (docs/AI_INTEGRATION.md §5.1): sizes, SHA-256 and licences, verified against Hugging Face. -->
    <EmbeddedResource Include="ModelCatalog.json" LogicalName="Blazma.AI.ModelCatalog.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Protocol/environment helpers are unit-tested directly. -->
    <InternalsVisibleTo Include="Blazma.Tests" />
  </ItemGroup>
</Project>
