; Engine configuration file.
config_version=5

[application]
config/name="Blazma Animation"
config/use_custom_user_dir=true
config/custom_user_dir_name="BlazmaAnimation"
config/features=PackedStringArray("4.7", "C#")
run/main_scene="res://scenes/Main.tscn"

[dotnet]
project/assembly_name="Blazma.UI"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[autoload]
App="*res://scripts/App/AppController.cs"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=2
window/subwindows/embed_subwindows=false

[gui]
theme/custom_font="res://assets/fonts/IBMPlexSansArabic-Regular.ttf"

[internationalization]
locale/translations=PackedStringArray("res://translations/ar.po")
locale/include_text_server_data=true
