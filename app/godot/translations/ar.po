msgid "This character has no hips mapped to the humanoid skeleton. Map the hips bone first."
msgstr "لا يوجد حوض مربوط بالهيكل البشري لهذه الشخصية. اربط عظمة الحوض أولًا."

msgid "This clip animates a different character."
msgstr "هذا المقطع يحرّك شخصية أخرى."

msgid "Auto-balance failed: {0}"
msgstr "فشلت الموازنة التلقائية: {0}"

msgid "Balance"
msgstr "التوازن"

msgid "Frame {0}: {1}"
msgstr "الإطار {0}: {1}"

msgid "Frame {0}: {1} (margin {2} cm)"
msgstr "الإطار {0}: {1} (الهامش {2} سم)"

msgid "Secondary Motion"
msgstr "الحركة الثانوية"

msgid "Make part of the body lag behind the motion and settle, like a spring. The result is written as ordinary rotation keys, so you can still edit them."
msgstr "اجعل جزءًا من الجسم يتأخر عن الحركة ثم يستقر كالنابض. تُكتب النتيجة كمفاتيح دوران عادية، فيمكنك تعديلها بعد ذلك."

msgid "Spine and head"
msgstr "العمود الفقري والرأس"

msgid "Head only"
msgstr "الرأس فقط"

msgid "Which bones follow through: the spine and head, only the head and neck, or both arms."
msgstr "العظام التي تتأخر: العمود الفقري والرأس، أو الرأس والرقبة فقط، أو الذراعان."

msgid "Stiffness"
msgstr "الصلابة"

msgid "How strongly the bones are pulled back to the original motion. Higher is snappier."
msgstr "شدة سحب العظام إلى الحركة الأصلية. القيمة الأعلى تعني استجابة أسرع."

msgid "Damping"
msgstr "التخميد"

msgid "How quickly the swinging dies out. Higher settles faster."
msgstr "سرعة تلاشي الاهتزاز. القيمة الأعلى تعني استقرارًا أسرع."

msgid "Max lag (degrees)"
msgstr "أقصى تأخر (درجات)"

msgid "The most a bone may lag behind, in degrees."
msgstr "أكبر تأخر مسموح للعظمة، بالدرجات."

msgid "Use every frame of the clip."
msgstr "استخدام كل إطارات المقطع."

msgid "very bouncy"
msgstr "شديد الارتداد"

msgid "springy"
msgstr "نابضي"

msgid "smooth"
msgstr "ناعم"

msgid "heavy and slow"
msgstr "ثقيل وبطيء"

msgid "About {0} swings per second, damping ratio {1}: {2}."
msgstr "نحو {0} ذبذبة في الثانية، ونسبة التخميد {1}: {2}."

msgid "Secondary motion added."
msgstr "أُضيفت الحركة الثانوية."

msgid "{0} rotation keys on {1} bones. The biggest lag is {2} degrees."
msgstr "{0} مفتاح دوران على {1} عظمة. أكبر تأخر {2} درجة."

