msgstr "أزل هذا المقطع من التسلسل. لا يُحذف المقطع نفسه."

msgid "No sequence yet"
msgstr "لا يوجد تسلسل بعد"

msgid "This character has no clips to add yet. Key or generate a clip first."
msgstr "ليس لهذه الشخصية مقاطع لإضافتها بعد. سجّل مقطعًا أو ولّده أولًا."

msgid "{0} items could not be played and are skipped."
msgstr "تعذّر تشغيل {0} عنصر وتم تخطيه."

msgid "Track A"
msgstr "المسار أ"

msgid "Track B"
msgstr "المسار ب"

msgid "No sequence yet. Press New to make one, then add clips."
msgstr "لا يوجد تسلسل بعد. اضغط «جديد» لإنشاء واحد ثم أضف مقاطع."

msgid "Add a clip to start this sequence."
msgstr "أضف مقطعًا لبدء هذا التسلسل."

msgid "This sequence cannot be played: a clip or the character it uses is missing or does not fit."
msgstr "لا يمكن تشغيل هذا التسلسل: مقطع أو الشخصية التي يستخدمها مفقودة أو غير مناسبة."

msgid "{0}: starts at frame {1}, fade-in {2} frames, speed {3}, repeats {4}"
msgstr "{0}: يبدأ عند الإطار {1}، التلاشي {2} إطارًا، السرعة {3}، التكرار {4}"

msgid "Drag to change the fade-in length."
msgstr "اسحب لتغيير طول الظهور التدريجي."

msgid "Drag to change the speed."
msgstr "اسحب لتغيير السرعة."

msgid "Drag to move this clip in time."
msgstr "اسحب لتحريك هذا المقطع في الزمن."

msgid "Start from a ready-made motion: idle, walk, run, jump, wave, attack. Apply it to a character as a new clip."
msgstr "ابدأ من حركة جاهزة: سكون، مشي، جري، قفز، تلويح، هجوم. طبّقها على شخصية كمقطع جديد."

msgid "Foot lock…"
msgstr "تثبيت القدمين…"

msgid "Stop the feet from sliding on the ground in this clip."
msgstr "امنع انزلاق القدمين على الأرض في هذا المقطع."

msgid "Retarget…"
msgstr "إعادة توجيه…"

msgid "Copy a clip onto another character."
msgstr "انسخ مقطعًا إلى شخصية أخرى."

msgid "Show foot contacts"
msgstr "إظهار ملامسة القدمين"
msgid "Too many clips blend at the same time (at most 8). Move a clip so fewer overlap."
msgstr "تتمازج مقاطع كثيرة في الوقت نفسه (8 كحد أقصى). حرّك مقطعًا ليتداخل عدد أقل."

msgid "This file is not a valid .glb model."
msgstr "هذا الملف ليس نموذج ‎.glb صالحًا."

msgid "This kind of model file is not supported."
msgstr "هذا النوع من ملفات النماذج غير مدعوم."

msgid "Something went wrong inside Blazma. Your project is unchanged. Please try again."
msgstr "حدث خطأ داخل Blazma. مشروعك لم يتغير. حاول مرة أخرى."

msgid "The sequence is too big: it has too many clips or is too long to process."
msgstr "التسلسل كبير جدًا: فيه مقاطع كثيرة أو هو أطول من أن يُعالَج."

msgid "This sequence is too big to play: it has too many clips or is too long."
msgstr "هذا التسلسل كبير جدًا للتشغيل: فيه مقاطع كثيرة أو هو طويل جدًا."


