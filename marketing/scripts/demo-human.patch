+    /// <summary>A plain arrow pointer drawn over the window (the recorder does not capture the OS cursor).</summary>
+    sealed partial class Pointer : Control
+    {
+        public float Press;   // 0..1, small squash while the button is held
+        public Pointer() { MouseFilter = MouseFilterEnum.Ignore; ZIndex = 4090; Size = Vector2.Zero; }
+        public override void _Draw()
+        {
+            var k = 1.25f * (1f - 0.1f * Press);
+            Vector2[] pts = { new(0, 0), new(0, 24), new(5.5f, 19), new(9.5f, 28.5f), new(13, 27), new(9, 18), new(17, 18) };
+            for (var i = 0; i < pts.Length; i++) pts[i] *= k;
+            var sh = new Vector2[pts.Length]; for (var i = 0; i < pts.Length; i++) sh[i] = pts[i] + new Vector2(1.5f, 2.5f);
+            DrawColoredPolygon(sh, new Color(0, 0, 0, 0.35f));
+            DrawColoredPolygon(pts, Colors.White);
+            DrawPolyline(new List<Vector2>(pts) { pts[0] }.ToArray(), new Color(0.07f, 0.07f, 0.07f), 1.6f, true);
+        }
+    }
+    Pointer _ptr = null!;
+    Vector2 _cur = new(1500, 700);
+    readonly System.Random _rng = new(11);
+
+    void PutPointer(Vector2 p)
+    {
+        _cur = p; _ptr.Position = p; _ptr.QueueRedraw();
+        var ev = new InputEventMouseMotion { Position = p, GlobalPosition = p };
+        GetViewport().PushInput(ev, false);
+    }
+    async Task Glide(Vector2 to, double dur)                     // eased, slightly curved, a small overshoot and settle
+    {
+        var from = _cur; var d = to - from; var len = d.Length();
+        var nrm = len > 1 ? new Vector2(-d.Y, d.X) / len : Vector2.Zero;
+        var bend = nrm * len * (float)(0.05 + 0.08 * _rng.NextDouble()) * (_rng.Next(2) == 0 ? -1 : 1);
+        var over = len > 1 ? to + d / len * (float)(5 + 6 * _rng.NextDouble()) : to;
+        var d1 = dur * 0.86; var t = 0.0; var ph = _rng.NextDouble() * 6.28;
+        while (t < d1)
+        {
+            await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame); t += GetProcessDeltaTime();
+            var p = Math.Min(1.0, t / d1); var e = p < 0.5 ? 4 * p * p * p : 1 - Math.Pow(-2 * p + 2, 3) / 2;
+            var m = from.Lerp(over, (float)e) + bend * (float)Math.Sin(Math.PI * e);
+            m += new Vector2((float)Math.Sin(t * 23 + ph), (float)Math.Cos(t * 19 + ph)) * 0.7f * (float)(1 - e);
+            PutPointer(m);
+        }
+        var s0 = _cur; t = 0; var d2 = Math.Max(0.12, dur * 0.14);
+        while (t < d2)
+        {
+            await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame); t += GetProcessDeltaTime();
+            var p = Math.Min(1.0, t / d2); PutPointer(s0.Lerp(to, (float)(1 - Math.Pow(1 - p, 3))));
+        }
+        PutPointer(to);
+    }
+    async Task Click(bool real)                                  // press + release at the pointer; `real` sends the actual mouse events to the app
+    {
+        GD.Print($"DEMO pointer {_cur.X:F0},{_cur.Y:F0}"); Mark("click");
+        if (real) GetViewport().PushInput(new InputEventMouseButton { Position = _cur, GlobalPosition = _cur, ButtonIndex = MouseButton.Left, Pressed = true, ButtonMask = MouseButtonMask.Left }, false);
+        for (var i = 0; i < 5; i++) { _ptr.Press = (i + 1) / 5f; _ptr.QueueRedraw(); await Wait(1.0 / 60); }
+        await Wait(0.05);
+        if (real) GetViewport().PushInput(new InputEventMouseButton { Position = _cur, GlobalPosition = _cur, ButtonIndex = MouseButton.Left, Pressed = false }, false);
+        for (var i = 0; i < 5; i++) { _ptr.Press = 1f - (i + 1) / 5f; _ptr.QueueRedraw(); await Wait(1.0 / 60); }
+    }
+    static Vector2 Aim(Control c, float fx = 0.5f, float fy = 0.5f)   // controls inside the embedded dialog report window-local rects: add the window origin
+    { var r = c.GetGlobalRect(); var o = c.GetWindow() is { } w && w != c.GetTree().Root ? (Vector2)w.Position : Vector2.Zero; return o + r.Position + new Vector2(r.Size.X * fx, r.Size.Y * fy); }
+    async Task Drift(double seconds, Vector2 amp)                // the hand resting on the mouse: tiny wander
+    {
+        var c0 = _cur; var t = 0.0;
+        while (t < seconds) { await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame); t += GetProcessDeltaTime(); PutPointer(c0 + new Vector2((float)Math.Sin(t * 1.7) * amp.X, (float)Math.Cos(t * 1.3) * amp.Y)); }
+    }
