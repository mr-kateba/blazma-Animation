+        await Click(false);
+        await Wait(0.9);
+        Mark("typing-start");
+        // human typing: uneven rhythm, a longer beat after each word, one slip («اجرو») that is noticed and backspaced
+        var typed = new System.Text.StringBuilder();
+        async Task Put(string ch, double delay)
+        {
+            typed.Append(ch); dlg.Prompt.Text = typed.ToString(); dlg.Prompt.SetCaretColumn(typed.Length);
+            dlg.Prompt.EmitSignal(TextEdit.SignalName.TextChanged); await Wait(delay);
+        }
+        async Task Back(double delay) { typed.Length--; dlg.Prompt.Text = typed.ToString(); dlg.Prompt.SetCaretColumn(typed.Length); dlg.Prompt.EmitSignal(TextEdit.SignalName.TextChanged); await Wait(delay); }
+        double Gap(char c) => c == ' ' ? 0.20 + 0.18 * _rng.NextDouble() : c == '،' ? 0.34 + 0.22 * _rng.NextDouble() : 0.075 + 0.11 * _rng.NextDouble();
+        var slipAt = prompt.IndexOf("اجري") + 3;                  // the last letter of «اجري»
+        for (var i = 0; i < prompt.Length; i++)
+        {
+            if (i == slipAt)
