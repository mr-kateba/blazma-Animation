+                await Put("و", 0.30);                              // wrong key
+                await Wait(0.42);                                  // spots it
+                await Back(0.22);
+            }
+            await Put(prompt[i].ToString(), Gap(prompt[i]));
+        }
+        Mark("typing-end");
+        await Wait(0.5);
+        dlg.RefreshPlanNow();
+        await Wait(0.4);
+        await Drift(3.0, new Vector2(5, 3));                      // the plan is on screen: the hand rests
+        Mark("plan-read");
+        await Glide(Aim(dlg.GetOkButton()), 1.1);
+        await Wait(0.4);
+        await Click(false);                                       // (the Kimodo generation itself is cut: the saved real result is opened)
+        Mark("plan-end");
+        var reuse = SavePath is not null && System.IO.File.Exists(SavePath);
+        dlg.Hide();
+        if (reuse) { GD.Print("DEMO re-using " + SavePath + " opened=" + App.Open(SavePath!)); _w.Stage.FrameAll(); _w.Stage.Orbit(-70, 0); }
+        await Glide(_cur + new Vector2(-260, 150), 0.9);
+        await Wait(1.2);
+        var clip = App.ActiveClip;
+        var dur = clip is null ? 4.0 : clip.DurationFrames / clip.Fps.FramesPerSecond;
+        GD.Print($"DEMO clip {clip?.Name} dur={dur:F2}s");
+        App.GoToFrame(0);
+        await Glide(Aim(_w.Timeline.PlayButton), 1.2);
+        await Wait(0.3);
+        Mark("play-start");
+        await Click(true);                                        // a real click on Play
+        await Wait(0.1);
+        if (!App.Playing) App.Play();                             // (safety net if the click did not toggle playback)
+        await Wait(dur + 0.2);
+        App.Pause();
+        await Glide(_cur + new Vector2(120, -60), 1.0);
