<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Blazma.Core\Blazma.Core.csproj" />
    <ProjectReference Include="..\..\src\Blazma.Commands\Blazma.Commands.csproj" />
    <ProjectReference Include="..\..\src\Blazma.Rigging\Blazma.Rigging.csproj" />
    <ProjectReference Include="..\..\src\Blazma.Motion\Blazma.Motion.csproj" />
    <ProjectReference Include="..\..\src\Blazma.Agent\Blazma.Agent.csproj" />
    <!-- Built before the tests, which start them as separate processes (not referenced as libraries). -->
    <ProjectReference Include="..\..\agent\cli\Blazma.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\agent\mcp\Blazma.Mcp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Blazma.Export\Blazma.Export.csproj" />
  </ItemGroup>

</Project>