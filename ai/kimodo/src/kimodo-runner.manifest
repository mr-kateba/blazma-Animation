<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- kimodo-runner on Windows: make the process ANSI code page UTF-8 (Windows 10 1903+), so the UTF-8 model
     paths Blazma sends (e.g. a user folder with Arabic letters) reach kimodo.cpp's narrow-char fopen/std::filesystem calls
     unchanged. Without it, any path outside the system code page fails with "models_not_found". -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Blazma.KimodoRunner" version="0.2.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
